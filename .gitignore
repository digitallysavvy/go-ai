# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Unix binaries (no extension) - common names
main
**/main

# Build output directories
bin/
build/
builds/*
!builds/README.md
dist/

# Test binary, built with `go test -c`
*.test

# Common Go binary output names
# (These are what Go creates when you run `go build` in a directory)
clear-tool-uses
clear-thinking
multiple-strategies
text-to-video
image-to-video
multi-provider
math-agent
computer-use
code-execution
tool-search

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Editor/IDE
# .idea/
# .vscode/

.DS_Store
coverage.out

# Example compiled binaries. `go build` in an example directory writes an
# extensionless binary named after the directory, at any depth. Ignore
# extensionless lowercase files under examples/, but keep every directory
# traversable (git cannot re-include a file whose parent directory is
# excluded) and keep every file that has an extension: sources, nested
# go.mod/go.sum, READMEs, assets.
examples/**/[a-z]*
!examples/**/
!examples/**/*.*
!examples/**/go.mod
!examples/**/go.sum
examples/**/.DS_Store

# Docs website
website/node_modules/
website/build/
website/.docusaurus/

# Claude Code project files
CLAUDE.md
VERIFICATION_PLAN.md
PROGRESS.md
/logging
.docsnippets-*/
