+// QJS_EvalNoAutoAwait evaluates global, non-compile-only, non-async script
+// without automatically awaiting a promise result or draining the job
+// queue.
+//
+// Unlike QJS_Eval, this never calls js_std_await/js_std_loop: if
+// evaluation produces (or later yields) a promise that never settles --
+// e.g. a host call intentionally left pending until external approval --
+// QJS_Eval's js_std_await loop spins forever waiting for that one promise,
+// because in this sandboxed build there are no timers/sockets for
+// js_std_await's js_os_poll fallback to ever wake it. QJS_EvalNoAutoAwait
+// sidesteps that by returning evaluation's result exactly as produced --
+// promise or not, settled or not -- and leaving the caller to drive the
+// job queue itself via QJS_RunPendingJobs and inspect/unwrap promises via
+// QJS_PromiseState/QJS_PromiseResult.
+//
+// Only global, non-compile-only, non-JS_EVAL_FLAG_ASYNC evaluation is
+// supported (module evaluation and the async-global { value: <result> }
+// unwrap both go through paths in QJS_Eval that this function does not
+// replicate); opts.eval_flags must not request JS_EVAL_TYPE_MODULE,
+// JS_EVAL_FLAG_COMPILE_ONLY, or JS_EVAL_FLAG_ASYNC.
+JSValue QJS_EvalNoAutoAwait(JSContext *ctx, QJSEvalOptions opts)
+{
+    bool is_module = (opts.eval_flags & JS_EVAL_TYPE_MASK) == JS_EVAL_TYPE_MODULE;
+    bool is_compile_only = (opts.eval_flags & JS_EVAL_FLAG_COMPILE_ONLY) > 0;
+    bool is_async = (opts.eval_flags & JS_EVAL_FLAG_ASYNC) > 0;
+
+    if (is_module || is_compile_only || is_async)
+        return JS_ThrowTypeError(ctx, "QJS_EvalNoAutoAwait only supports global, non-compile-only, non-async evaluation");
+
+    JSValue result = load_buf(ctx, opts, opts.eval_flags, true);
+    if (JS_IsException(result))
+        return JS_Throw(ctx, JS_GetException(ctx));
+
+    return result;
 }
