+/* Module loader with support for appending common suffixes and JSON modules.
+ *
+ * When QJS_RuntimeModulesDisabled(JS_GetRuntime(ctx)) is set (see qjs.c's
+ * New_QJS / QJS_RuntimeModulesDisabled), this rejects every module
+ * specifier with a clean JS error before doing anything else -- no
+ * filesystem lookup, no JSON parsing, no delegation to js_module_loader.
+ * This is the second of two layers New_QJS's disable_modules flag drives:
+ * the qjs:std/qjs:os/qjs:bjson native modules are never *registered* in
+ * the first place (qjs.c's New_QJSContext), so they are never found via
+ * js_find_loaded_module and always reach this function; relative/absolute
+ * path imports (e.g. './x', '/x') never went through native-module
+ * registration at all and always reached this function anyway. Rejecting
+ * here closes both routes identically, with no partial allowlist. */
 JSModuleDef *QJS_ModuleLoader(JSContext *ctx, const char *module_name, void *opaque)
 {
+    if (QJS_RuntimeModulesDisabled(JS_GetRuntime(ctx)))
+    {
+        JS_ThrowTypeError(ctx, "module imports are disabled in this sandbox: '%s'", module_name);
+        return NULL;
+    }
+
     module_name = detect_entry_point((char *)module_name);
     if (!module_name)
         return NULL;
